{
  "compilerOptions": {
    "target": "es2020", // Or "es5" for broader compatibility, es2020 is fine for modern Node/browsers
    "lib": ["dom", "dom.iterable", "esnext"], // Ensure DOM and ESNext libs are included
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext", // Changed from CommonJS
    "moduleResolution": "bundler", // Changed from node, or use "nodenext"
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"], // Simplified include
  "exclude": ["node_modules", "dist"] // Added dist
}