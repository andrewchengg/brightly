// tsconfig.json
{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true, // noEmit is fine for Next.js app, ts-node compiles in memory
    "esModuleInterop": true,
    "module": "commonjs", // <<<< TRY THIS FOR SCRIPTS
    "moduleResolution": "node", // <<<< TRY THIS
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", ".next/types/**/*.ts"], // Added scripts
  "exclude": ["node_modules", "dist"]
}