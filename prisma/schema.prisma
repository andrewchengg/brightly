// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql" // Ensure this matches your Supabase DB
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Optional: If using Prisma Accelerate or Pulse
}

// --- User and Admin Models ---
model Admin {
  id        String   @id
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                   String    @id
  username             String    @unique
  name                 String
  email                String?   @unique
  phone                String?   @unique
  img                  String?
  parentId             String?
  classId              Int?
  gradeId              Int?
  schoolLevel          Int
  schoolName           String?
  initialSetupComplete Boolean   @default(false)
  currentStreak        Int       @default(0)
  lastActivityDate     DateTime?
  level                Int       @default(1)
  longestStreak        Int       @default(0)
  xpPoints             Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance           Attendance[]
  practiceSessions     PracticeSession[]
  results              Result[]
  events               Event[]
  class                Class?                @relation(fields: [classId], references: [id], onDelete: SetNull)
  grade                Grade?                @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  parent               Parent?               @relation(fields: [parentId], references: [id], onDelete: SetNull)
  studentBadges        StudentBadge[]
  oralPracticeAttempts OralPracticeAttempt[]
}

model Teacher {
  id        String   @id
  username  String   @unique
  name      String
  email     String?  @unique
  phone     String?  @unique
  address   String?
  img       String?
  bloodType String?
  sex       UserSex?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classesSupervised        Class[]           @relation("ClassSupervisor")
  lessons                  Lesson[]
  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByTeacher")
  subjectTeachers          SubjectTeacher[]
  // reviewedQuestions        Question[]        @relation("ReviewedByTeacher") // Optional: if a teacher reviews questions
}

model Parent {
  id       String  @id
  username String  @unique
  name     String
  phone    String? @unique
  email    String? @unique
  address  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByParent")
  students                 Student[]
}

model Grade {
  id    Int     @id @default(autoincrement())
  level Int     @unique
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  Class[]
  students Student[]
}

model Class {
  id           Int    @id @default(autoincrement())
  name         String
  capacity     Int?
  gradeId      Int
  supervisorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  announcements Announcement[]
  grade         Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  supervisor    Teacher        @relation("ClassSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  events        Event[]
  lessons       Lesson[]
  students      Student[]

  @@unique([name, gradeId])
}

model Subject {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lessons             Lesson[]
  practiceSessions    PracticeSession[]    @relation("SubjectPracticeSessions")
  topics              Topic[]
  subjectTeachers     SubjectTeacher[]
  oralPrompts         OralPrompt[]
  
  questions           Question[]                 @relation("SubjectQuestions") // Live questions
  archivedQuestions   ArchivedOriginalQuestion[] @relation("ArchivedSubjectQuestions") // Archived questions
}

model Topic {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?              @db.Text
  subjectId           Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  practiceSessions    PracticeSession[]
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  oralPrompts         OralPrompt[]
  
  questions           Question[]                 @relation("TopicQuestions") // Live questions
  archivedQuestions   ArchivedOriginalQuestion[] @relation("ArchivedTopicQuestions") // Archived questions

  @@unique([name, subjectId])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day?
  startTime DateTime
  endTime   DateTime
  subjectId Int
  classId   Int?
  teacherId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]
  class      Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
}

model QuestionGroup {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  description          String?              @db.Text
  sourceYear           Int?
  sourceLevel          String?
  sourceSchool         String?
  sourceAssessmentType String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  audioUrl             String?          


  practiceSessions     PracticeSession[]    @relation("BasedOnQuestionGroup")
  
  questions            Question[]                 @relation("QuestionGroupQuestions") // Live questions
  archivedQuestions    ArchivedOriginalQuestion[] @relation("ArchivedQuestionGroupQuestions") // Archived questions
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuestionTag[] // Tags apply to live/refactored questions
}

// Live questions, subject to refactoring, used by the application
model Question {
  id                   Int             @id @default(autoincrement())
  pdfPageNumber        Int
  questionNumberOnPage String
  text                 String          @db.Text // This field will be refactored
  questionType         QuestionType    @default(MULTIPLE_CHOICE)
  options              Json?           // This field will be refactored
  correctAnswer        Json?           // This field will be refactored
  answerKeyRawText     String?         @db.Text // This might be refactored or just kept
  explanation          String?         @db.Text // This field will be refactored
  hint                 String?         @db.Text // This field will be refactored
  marks                Int?
  difficulty           DifficultyLevel @default(MEDIUM)
  pointsAwarded        Int             @default(10)
  subjectId            Int
  topicId              Int
  questionGroupId      Int?
  imageUrl             String?         // This might be updated if a new diagram is used
  fullPageImageUrl     String?         // This might be updated
  audioUrl             String?         // This might be updated

  sourceYear           Int?            // Usually remains the same
  sourceLevel          String?         // Usually remains the same
  sourceSchool         String?         // Usually remains the same
  sourceAssessmentType String?         // Usually remains the same

  productionReady      Boolean         @default(false) // Key flag
  reviewedAt           DateTime?
  // reviewerId        String?         // Optional: Link to Teacher/Admin who reviewed
  // reviewer          Teacher?        @relation("ReviewedByTeacher", fields: [reviewerId], references: [id], onDelete:SetNull)

  createdAt            DateTime        @default(now()) // When the original was created, or when this record was first made
  updatedAt            DateTime        @updatedAt      // When this live/refactored version was last updated

  subject              Subject         @relation("SubjectQuestions", fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topic           @relation("TopicQuestions", fields: [topicId], references: [id], onDelete: Cascade)
  questionGroup        QuestionGroup?  @relation("QuestionGroupQuestions", fields: [questionGroupId], references: [id], onDelete: SetNull)
  
  studentAnswers       StudentAnswer[]
  tags                 QuestionTag[]   

  archivedVersion      ArchivedOriginalQuestion? // One-to-one link TO its archived original version

  @@unique([questionGroupId, pdfPageNumber, questionNumberOnPage], name: "unique_live_question_in_group_page_num")
}

// Archived original questions, untouched, for AI training
model ArchivedOriginalQuestion {
  id                   Int             @id @default(autoincrement()) // Its own ID
  
  liveQuestionId       Int             @unique // Foreign key to the live Question table it was archived from
  liveQuestion         Question        @relation(fields: [liveQuestionId], references: [id], onDelete:Cascade) // If live Q is deleted, archive is too.

  // Fields copied from the original Question record at the time of archival
  pdfPageNumber        Int
  questionNumberOnPage String
  text                 String          @db.Text
  questionType         QuestionType
  options              Json?
  correctAnswer        Json?
  answerKeyRawText     String?         @db.Text
  explanation          String?         @db.Text
  hint                 String?         @db.Text
  marks                Int?
  difficulty           DifficultyLevel
  pointsAwarded        Int
  subjectId            Int
  topicId              Int
  questionGroupId      Int?
  imageUrl             String?
  fullPageImageUrl     String?
  audioUrl             String?

  sourceYear           Int?
  sourceLevel          String?
  sourceSchool         String?
  sourceAssessmentType String?

  archivedAt           DateTime        @default(now()) // When this archive record was created

  // Relations to Subject, Topic, QuestionGroup for context at time of archival
  // These ensure that even if a Subject/Topic/Group is deleted from the live system,
  // the archived question still knows what it was originally associated with.
  // onDelete: SetNull means if the related Subject/Topic/Group is deleted, the foreign key here becomes null,
  // but the archived question itself remains. Choose Cascade if you want archives deleted when their subject/topic/group is.
  subject              Subject         @relation("ArchivedSubjectQuestions", fields: [subjectId], references: [id], onDelete:SetNull) 
  topic                Topic           @relation("ArchivedTopicQuestions", fields: [topicId], references: [id], onDelete:SetNull)   
  questionGroup        QuestionGroup?  @relation("ArchivedQuestionGroupQuestions", fields: [questionGroupId], references: [id], onDelete:SetNull)

  // No studentAnswers or tags on archived questions
  // @@unique([questionGroupId, pdfPageNumber, questionNumberOnPage], name: "unique_archived_question_in_group_page_num") // Optional
}


model QuestionTag {
  questionId Int // Points to Question.id (the live/refactored one)
  tagId      Int
  assignedAt DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model PracticeSession {
  id                      String                @id @default(uuid())
  studentId               String
  title                   String?
  type                    PracticeSessionType   @default(PRACTICE)
  status                  PracticeSessionStatus @default(NOT_STARTED)
  examDurationMinutes     Int?
  subjectId               Int?
  topicId                 Int?
  basedOnQuestionGroupId  Int?
  assignedByParentId      String?
  assignedByTeacherId     String?
  startTime               DateTime              @default(now())
  endTime                 DateTime?
  durationSeconds         Int?
  score                   Int?
  totalQuestions          Int?
  correctAnswers          Int?
  xpEarned                Int                   @default(0)
  challengeWeekIdentifier DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student              Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject              Subject?        @relation("SubjectPracticeSessions", fields: [subjectId], references: [id], onDelete: SetNull)
  topic                Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  basedOnQuestionGroup QuestionGroup?  @relation("BasedOnQuestionGroup", fields: [basedOnQuestionGroupId], references: [id], onDelete: SetNull)
  assignedByParent     Parent?         @relation("AssignedSessionsByParent", fields: [assignedByParentId], references: [id], onDelete: SetNull)
  assignedByTeacher    Teacher?        @relation("AssignedSessionsByTeacher", fields: [assignedByTeacherId], references: [id], onDelete: SetNull)
  studentAnswers       StudentAnswer[]
  result               Result?
}

model StudentAnswer {
  id                String   @id @default(uuid())
  practiceSessionId String
  questionId        Int      // Points to Question.id (the live/refactored one)
  submittedAnswer   Json?
  isCorrect         Boolean?
  pointsEarned      Int      @default(0)
  attemptedAt       DateTime @default(now())
  feedback          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practiceSession PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSessionId, questionId])
}

model Result {
  id                Int      @id @default(autoincrement())
  score             Int
  practiceSessionId String   @unique
  studentId         String
  submittedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practiceSession PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  lessonId  Int
  studentId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  startTime   DateTime
  endTime     DateTime
  description String   @db.Text
  classId     Int?
  studentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime @default(now())
  description String   @db.Text
  classId     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model Badge {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  icon        String?
  criteria    String  @db.Text
  xpBonus     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   Int
  awardedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([studentId, badgeId])
}

model SubjectTeacher {
  subjectId  Int
  teacherId  String
  assignedAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
}

// +++ Oral Practice Models +++
enum OralPromptType {
  PASSAGE_READING
  PICTURE_CONVERSATION
  VIDEO_CONVERSATION
}

model OralPrompt {
  id                  Int            @id @default(autoincrement())
  title               String
  subjectId           Int
  topicId             Int?
  promptType          OralPromptType
  description         String?        @db.Text
  studentInstructions String?        @db.Text
  imageUrl            String?
  videoUrl            String?
  guidingQuestions    Json? // Expect: string[]
  passageText         String?        @db.Text
  difficulty          DifficultyLevel? @default(MEDIUM)
  keywords            String[]       @default([])
  estimatedTimeSeconds Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  productionReady     Boolean        @default(false)

  subject              Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  oralPracticeAttempts OralPracticeAttempt[]
}

model OralPracticeAttempt {
  id                  String   @id @default(uuid())
  studentId           String
  oralPromptId        Int
  attemptedAt         DateTime @default(now())
  audioRecordingUrl   String?
  transcription       String?  @db.Text
  aiFeedback          Json?
  teacherFeedback     String?  @db.Text
  score               Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  oralPrompt OralPrompt @relation(fields: [oralPromptId], references: [id], onDelete: Cascade)
}

// ------------- Enums -------------
enum UserSex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_THE_BLANK
  OPEN_ENDED
  MULTI_PART
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum PracticeSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PracticeSessionType {
  PRACTICE
  MOCK_EXAM
  ASSIGNMENT_ATTEMPT
  TOPIC_QUIZ
  QUESTION_GROUP_PRACTICE
  WEEKLY_CHALLENGE
  LISTENING_COMPREHENSION 
}