generator client {
  provider = "prisma-client-js"
}

generator prisma_seed {
  provider = "prisma-client-js"
  seed     = "node prisma/seed.js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id                   String            @id
  username             String            @unique
  name                 String
  email                String?           @unique
  phone                String?           @unique
  img                  String?
  createdAt            DateTime          @default(now())
  parentId             String?
  classId              Int?
  gradeId              Int?
  schoolLevel          Int
  schoolName           String?
  initialSetupComplete Boolean           @default(false)
  currentStreak        Int               @default(0) @map("current_streak")
  lastActivityDate     DateTime?         @map("last_activity_date")
  level                Int               @default(1)
  longestStreak        Int               @default(0) @map("longest_streak")
  xpPoints             Int               @default(0) @map("xp_points")
  attendance           Attendance[]
  practiceSessions     PracticeSession[]
  results              Result[]
  class                Class?            @relation(fields: [classId], references: [id])
  grade                Grade?            @relation(fields: [gradeId], references: [id])
  parent               Parent?           @relation(fields: [parentId], references: [id])
  badges               Badge[]           @relation("StudentBadges")
}

model Teacher {
  id                       String            @id
  username                 String            @unique
  name                     String
  email                    String?           @unique
  phone                    String?           @unique
  address                  String
  img                      String?
  bloodType                String?
  sex                      UserSex?
  createdAt                DateTime          @default(now())
  classesSupervised        Class[]           @relation("ClassSupervisor")
  lessons                  Lesson[]
  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByTeacher")
  subjects                 Subject[]         @relation("SubjectToTeacher")
}

model Parent {
  id                       String            @id
  username                 String            @unique
  name                     String
  phone                    String?           @unique
  email                    String?           @unique
  address                  String?
  createdAt                DateTime          @default(now())
  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByParent")
  students                 Student[]
}

model Grade {
  id       Int       @id @default(autoincrement())
  level    Int       @unique
  classes  Class[]
  students Student[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  capacity      Int
  gradeId       Int
  supervisorId  String
  announcements Announcement[]
  grade         Grade          @relation(fields: [gradeId], references: [id])
  supervisor    Teacher        @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  events        Event[]
  lessons       Lesson[]
  students      Student[]
}

model Subject {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  assignments      Assignment[]      @relation("SubjectAssignments")
  exams            Exam[]            @relation("SubjectExams")
  lessons          Lesson[]
  practiceSessions PracticeSession[] @relation("SubjectPracticeSessions")
  questions        Question[]        @relation("SubjectQuestions")
  topics           Topic[]
  teachers         Teacher[]         @relation("SubjectToTeacher")
}

model Topic {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  subjectId        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assignments      Assignment[]      @relation("TopicAssignments")
  exams            Exam[]            @relation("TopicExams")
  practiceSessions PracticeSession[]
  questions        Question[]
  subject          Subject           @relation(fields: [subjectId], references: [id])

  @@unique([name, subjectId])
}

model Lesson {
  id          Int          @id @default(autoincrement())
  name        String
  day         Day?
  startTime   DateTime
  endTime     DateTime
  subjectId   Int
  classId     Int?
  teacherId   String
  assignments Assignment[]
  attendance  Attendance[]
  exams       Exam[]
  class       Class?       @relation(fields: [classId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
}

model Question {
  id             Int             @id @default(autoincrement())
  text           String
  questionType   QuestionType    @default(MULTIPLE_CHOICE)
  options        Json?
  correctAnswer  Json?
  explanation    String?
  difficulty     DifficultyLevel @default(MEDIUM)
  pointsAwarded  Int             @default(10)
  subjectId      Int
  topicId        Int
  imageUrl       String?
  audioUrl       String?
  tags           String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  subject        Subject         @relation("SubjectQuestions", fields: [subjectId], references: [id])
  topic          Topic           @relation(fields: [topicId], references: [id])
  studentAnswers StudentAnswer[]
}

model PracticeSession {
  id                  String                @id @default(uuid())
  studentId           String
  title               String?
  status              PracticeSessionStatus @default(NOT_STARTED)
  subjectId           Int?
  topicId             Int?
  basedOnExamId       Int?
  basedOnAssignmentId Int?
  assignedByParentId  String?
  assignedByTeacherId String?
  startTime           DateTime              @default(now())
  endTime             DateTime?
  durationSeconds     Int?
  score               Int?
  totalQuestions      Int?
  correctAnswers      Int?
  xpEarned            Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assignedByParent    Parent?               @relation("AssignedSessionsByParent", fields: [assignedByParentId], references: [id])
  assignedByTeacher   Teacher?              @relation("AssignedSessionsByTeacher", fields: [assignedByTeacherId], references: [id])
  basedOnAssignment   Assignment?           @relation("PracticeSessionsForAssignment", fields: [basedOnAssignmentId], references: [id])
  basedOnExam         Exam?                 @relation("PracticeSessionsForExam", fields: [basedOnExamId], references: [id])
  student             Student               @relation(fields: [studentId], references: [id])
  subject             Subject?              @relation("SubjectPracticeSessions", fields: [subjectId], references: [id])
  topic               Topic?                @relation(fields: [topicId], references: [id])
  studentAnswers      StudentAnswer[]
}

model StudentAnswer {
  id                String          @id @default(uuid())
  practiceSessionId String
  questionId        Int
  submittedAnswer   Json?
  isCorrect         Boolean?
  pointsEarned      Int             @default(0)
  attemptedAt       DateTime        @default(now())
  feedback          String?
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id])

  @@unique([practiceSessionId, questionId])
}

model Exam {
  id               Int               @id @default(autoincrement())
  title            String
  startTime        DateTime?
  endTime          DateTime?
  lessonId         Int?
  description      String?
  subjectId        Int?
  topicId          Int?
  lesson           Lesson?           @relation(fields: [lessonId], references: [id])
  subject          Subject?          @relation("SubjectExams", fields: [subjectId], references: [id])
  topic            Topic?            @relation("TopicExams", fields: [topicId], references: [id])
  practiceSessions PracticeSession[] @relation("PracticeSessionsForExam")
  results          Result[]
}

model Assignment {
  id               Int               @id @default(autoincrement())
  title            String
  lessonId         Int?
  description      String?
  dueDate          DateTime?
  subjectId        Int?
  topicId          Int?
  lesson           Lesson?           @relation(fields: [lessonId], references: [id])
  subject          Subject?          @relation("SubjectAssignments", fields: [subjectId], references: [id])
  topic            Topic?            @relation("TopicAssignments", fields: [topicId], references: [id])
  practiceSessions PracticeSession[] @relation("PracticeSessionsForAssignment")
  results          Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exam         Exam?       @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  lessonId  Int
  studentId String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  startTime   DateTime
  endTime     DateTime
  description String
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime @default(now())
  description String
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Badge {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  icon        String?
  criteria    String
  xpBonus     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[] @relation("StudentBadges")
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN_ENDED
  FILL_IN_THE_BLANK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  CHALLENGING
}

enum PracticeSessionStatus {
  NOT_STARTED
  STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}
