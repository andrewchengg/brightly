generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                   String                    @id
  username             String                    @unique
  name                 String
  email                String?                   @unique
  phone                String?                   @unique
  img                  String?
  createdAt            DateTime                  @default(now())
  parentId             String?
  classId              Int?
  gradeId              Int?
  schoolLevel          Int
  schoolName           String?
  initialSetupComplete Boolean                   @default(false)
  level                Int                       @default(1)
  updatedAt            DateTime                  @updatedAt
  currentStreak        Int                       @default(0)
  lastActivityDate     DateTime?
  longestStreak        Int                       @default(0)
  xpPoints             Int                       @default(0)
  attendance           Attendance[]
  chatSessions         ChatSession[]
  events               Event[]
  oralPracticeAttempts OralPracticeAttempt[]
  practiceSessions     PracticeSession[]
  questionReports      QuestionReport[]
  results              Result[]
  class                Class?                    @relation(fields: [classId], references: [id])
  grade                Grade?                    @relation(fields: [gradeId], references: [id])
  parent               Parent?                   @relation(fields: [parentId], references: [id])
  studentBadges        StudentBadge[]
  studentQuests        StudentQuest[]
  uploadedQuestions    StudentUploadedQuestion[]
}

model Teacher {
  id                       String            @id
  username                 String            @unique
  name                     String
  email                    String?           @unique
  phone                    String?           @unique
  address                  String?
  img                      String?
  bloodType                String?
  sex                      UserSex?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  classesSupervised        Class[]           @relation("ClassSupervisor")
  lessons                  Lesson[]
  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByTeacher")
  subjectTeachers          SubjectTeacher[]
}

model Parent {
  id                       String                @id
  username                 String                @unique
  name                     String
  phone                    String?               @unique
  email                    String?               @unique
  address                  String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  referralSource           String?
  assignedPracticeSessions PracticeSession[]     @relation("AssignedSessionsByParent")
  students                 Student[]
  subjectSubscriptions     SubjectSubscription[]
}

model Grade {
  id        Int       @id @default(autoincrement())
  level     Int       @unique
  createdAt DateTime  @default(now())
  name      String?
  updatedAt DateTime  @updatedAt
  classes   Class[]
  students  Student[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String
  capacity      Int?
  gradeId       Int
  supervisorId  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  grade         Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  supervisor    Teacher        @relation("ClassSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  events        Event[]
  lessons       Lesson[]
  students      Student[]

  @@unique([name, gradeId])
}

model Subject {
  id                Int                        @id @default(autoincrement())
  name              String                     @unique
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  archivedQuestions ArchivedOriginalQuestion[] @relation("ArchivedSubjectQuestions")
  lessons           Lesson[]
  oralPrompts       OralPrompt[]
  practiceSessions  PracticeSession[]          @relation("SubjectPracticeSessions")
  questions         Question[]                 @relation("SubjectQuestions")
  uploadedQuestions StudentUploadedQuestion[]  @relation("StudentUploadedQuestionSubjects")
  subjectTeachers   SubjectTeacher[]
  topics            Topic[]
  subjectPlan       SubjectPlan?
}

model Topic {
  id                Int                        @id @default(autoincrement())
  name              String
  description       String?
  subjectId         Int
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  archivedQuestions ArchivedOriginalQuestion[] @relation("ArchivedTopicQuestions")
  oralPrompts       OralPrompt[]
  practiceSessions  PracticeSession[]          @relation("TopicPracticeSessions")
  questions         Question[]                 @relation("TopicQuestions")
  uploadedQuestions StudentUploadedQuestion[]  @relation("StudentUploadedQuestionTopics")
  subject           Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([name, subjectId])
}

model Lesson {
  id         Int          @id @default(autoincrement())
  name       String
  day        Day?
  startTime  DateTime
  endTime    DateTime
  subjectId  Int
  classId    Int?
  teacherId  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendance Attendance[]
  class      Class?       @relation(fields: [classId], references: [id])
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
}

model QuestionGroup {
  id                   Int                        @id @default(autoincrement())
  createdAt            DateTime                   @default(now())
  description          String?
  name                 String                     @unique
  sourceAssessmentType String?
  sourceLevel          String?
  sourceSchool         String?
  sourceYear           Int?
  updatedAt            DateTime                   @updatedAt
  audioUrl             String?
  archivedQuestions    ArchivedOriginalQuestion[] @relation("ArchivedQuestionGroupQuestions")
  practiceSessions     PracticeSession[]          @relation("BasedOnQuestionGroup")
  questions            Question[]                 @relation("QuestionGroupQuestions")
}

model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  questions QuestionTag[]
}

model Question {
  id                   Int                       @id @default(autoincrement())
  text                 String
  questionType         QuestionType              @default(MULTIPLE_CHOICE)
  options              Json?
  correctAnswer        Json?
  explanation          String?
  difficulty           DifficultyLevel           @default(MEDIUM)
  pointsAwarded        Int                       @default(10)
  subjectId            Int
  topicId              Int
  imageUrl             String?
  audioUrl             String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  hint                 String?
  marks                Int?
  questionGroupId      Int?
  answerKeyRawText     String?
  fullPageImageUrl     String?
  pdfPageNumber        Int
  questionNumberOnPage String
  sourceAssessmentType String?
  sourceLevel          String?
  sourceSchool         String?
  sourceYear           Int?
  productionReady      Boolean                   @default(false)
  reviewedAt           DateTime?
  isRefactored         Boolean                   @default(false)
  archivedVersion      ArchivedOriginalQuestion?
  questionGroup        QuestionGroup?            @relation("QuestionGroupQuestions", fields: [questionGroupId], references: [id])
  subject              Subject                   @relation("SubjectQuestions", fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topic                     @relation("TopicQuestions", fields: [topicId], references: [id], onDelete: Cascade)
  reports              QuestionReport[]
  tags                 QuestionTag[]
  studentAnswers       StudentAnswer[]

  @@unique([questionGroupId, pdfPageNumber, questionNumberOnPage], name: "unique_live_question_in_group_page_num")
}

model ArchivedOriginalQuestion {
  id                   Int             @id @default(autoincrement())
  liveQuestionId       Int             @unique
  pdfPageNumber        Int
  questionNumberOnPage String
  text                 String
  questionType         QuestionType
  options              Json?
  correctAnswer        Json?
  answerKeyRawText     String?
  explanation          String?
  hint                 String?
  marks                Int?
  difficulty           DifficultyLevel
  pointsAwarded        Int
  subjectId            Int
  topicId              Int
  questionGroupId      Int?
  imageUrl             String?
  fullPageImageUrl     String?
  audioUrl             String?
  sourceYear           Int?
  sourceLevel          String?
  sourceSchool         String?
  sourceAssessmentType String?
  archivedAt           DateTime        @default(now())
  liveQuestion         Question        @relation(fields: [liveQuestionId], references: [id], onDelete: Cascade)
  questionGroup        QuestionGroup?  @relation("ArchivedQuestionGroupQuestions", fields: [questionGroupId], references: [id])
  subject              Subject         @relation("ArchivedSubjectQuestions", fields: [subjectId], references: [id], onDelete: SetNull)
  topic                Topic           @relation("ArchivedTopicQuestions", fields: [topicId], references: [id], onDelete: SetNull)
}

model QuestionTag {
  questionId Int
  tagId      Int
  assignedAt DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model PracticeSession {
  id                      String                @id @default(uuid())
  studentId               String
  title                   String?
  status                  PracticeSessionStatus @default(NOT_STARTED)
  subjectId               Int?
  topicId                 Int?
  assignedByParentId      String?
  assignedByTeacherId     String?
  startTime               DateTime              @default(now())
  endTime                 DateTime?
  durationSeconds         Int?
  totalQuestions          Int?
  correctAnswers          Int?
  xpEarned                Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  examDurationMinutes     Int?
  type                    PracticeSessionType   @default(PRACTICE)
  basedOnQuestionGroupId  Int?
  challengeWeekIdentifier DateTime?
  totalMarksEarned        Int?
  totalPossibleMarks      Int?
  assignedByParent        Parent?               @relation("AssignedSessionsByParent", fields: [assignedByParentId], references: [id])
  assignedByTeacher       Teacher?              @relation("AssignedSessionsByTeacher", fields: [assignedByTeacherId], references: [id])
  basedOnQuestionGroup    QuestionGroup?        @relation("BasedOnQuestionGroup", fields: [basedOnQuestionGroupId], references: [id])
  student                 Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject                 Subject?              @relation("SubjectPracticeSessions", fields: [subjectId], references: [id])
  topic                   Topic?                @relation("TopicPracticeSessions", fields: [topicId], references: [id])
  Result                  Result?
  studentAnswers          StudentAnswer[]
}

model StudentAnswer {
  id                String          @id @default(uuid())
  practiceSessionId String
  questionId        Int
  submittedAnswer   Json?
  isCorrect         Boolean?
  pointsEarned      Int             @default(0)
  attemptedAt       DateTime        @default(now())
  feedback          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSessionId, questionId])
  @@index([practiceSessionId])
  @@index([questionId])
  @@index([attemptedAt])
}

model Result {
  id                Int             @id @default(autoincrement())
  score             Int
  studentId         String
  practiceSessionId String          @unique
  submittedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  lessonId  Int
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  startTime   DateTime
  endTime     DateTime
  description String
  classId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  studentId   String?
  class       Class?   @relation(fields: [classId], references: [id])
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime @default(now())
  description String
  classId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class?   @relation(fields: [classId], references: [id])
}

model Badge {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String
  icon        String?
  criteria    String
  xpBonus     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  students    StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   Int
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, badgeId])
}

model StudentUploadedQuestion {
  id               String           @id @default(uuid())
  studentId        String
  originalFileName String?
  text             String
  questionType     QuestionType     @default(MULTIPLE_CHOICE)
  options          Json?
  correctAnswer    Json?
  explanation      String?
  hint             String?
  difficulty       DifficultyLevel  @default(MEDIUM)
  subjectId        Int?
  topicId          Int?
  processingStatus ProcessingStatus @default(PROCESSING)
  ocrText          String?
  aiProcessingLog  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  imageUrl         String?
  requiresImage    Boolean          @default(false)
  cropCoordinates  Json?
  diagramUrl       String?
  hasDiagram       Boolean          @default(false)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject          Subject?         @relation("StudentUploadedQuestionSubjects", fields: [subjectId], references: [id])
  topic            Topic?           @relation("StudentUploadedQuestionTopics", fields: [topicId], references: [id])

  @@index([studentId, createdAt])
  @@index([studentId, subjectId])
}

model SubjectTeacher {
  subjectId  Int
  teacherId  String
  assignedAt DateTime @default(now())
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
}

model OralPrompt {
  id                   Int                   @id @default(autoincrement())
  title                String
  subjectId            Int
  topicId              Int?
  promptType           OralPromptType
  description          String?
  studentInstructions  String?
  imageUrl             String?
  videoUrl             String?
  guidingQuestions     Json?
  passageText          String?
  difficulty           DifficultyLevel?      @default(MEDIUM)
  keywords             String[]              @default([])
  estimatedTimeSeconds Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  productionReady      Boolean               @default(false)
  oralPracticeAttempts OralPracticeAttempt[]
  subject              Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topic?                @relation(fields: [topicId], references: [id])
}

model OralPracticeAttempt {
  id                String     @id @default(uuid())
  studentId         String
  oralPromptId      Int
  attemptedAt       DateTime   @default(now())
  audioRecordingUrl String?
  transcription     String?
  aiFeedback        Json?
  teacherFeedback   String?
  score             Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  oralPrompt        OralPrompt @relation(fields: [oralPromptId], references: [id], onDelete: Cascade)
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id           String        @id
  studentId    String
  title        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  lastActivity DateTime      @default(now())
  messages     ChatMessage[]
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, lastActivity])
}

model ChatMessage {
  id        String      @id
  sessionId String
  role      MessageRole
  content   String
  imageUrl  String?
  hasImage  Boolean     @default(false)
  timestamp DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

model Quest {
  id            String              @id @default(uuid())
  questType     String              @unique
  title         String
  description   String
  baseTarget    Int
  targetFormula String?
  icon          String
  color         String
  category      WeeklyQuestCategory
  isActive      Boolean             @default(true)
  minLevel      Int                 @default(1)
  maxLevel      Int?
  rarity        QuestRarity         @default(COMMON)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  xpReward      Int                 @default(25)
  studentQuests StudentQuest[]
}

model StudentQuest {
  id          String    @id @default(uuid())
  studentId   String
  questId     String
  target      Int
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  weekStart   DateTime
  weekEnd     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, questId, weekStart])
  @@index([studentId, weekStart])
  @@index([weekStart, weekEnd])
  @@index([questId])
}

model QuestionReport {
  id          String             @id @default(uuid())
  questionId  Int
  studentId   String
  reportType  QuestionReportType
  description String
  status      ReportStatus       @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  question    Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([studentId])
  @@index([status])
}

enum UserSex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_THE_BLANK
  OPEN_ENDED
  MULTI_PART
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum PracticeSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PracticeSessionType {
  PRACTICE
  MOCK_EXAM
  ASSIGNMENT_ATTEMPT
  TOPIC_QUIZ
  QUESTION_GROUP_PRACTICE
  WEEKLY_CHALLENGE
  LISTENING_COMPREHENSION
}

enum ProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum WeeklyQuestCategory {
  CORE
  SUBJECT
  CONSISTENCY
  CHALLENGE
  PERFORMANCE
  SOCIAL
  LEARNING
}

enum QuestRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
}

enum QuestionReportType {
  INCORRECT_ANSWER
  WRONG_EXPLANATION
  POOR_FORMATTING
  TECHNICAL_ISSUE
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum OralPromptType {
  PASSAGE_READING
  PICTURE_CONVERSATION
  VIDEO_CONVERSATION
}

enum MessageRole {
  USER
  ASSISTANT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model SubjectPlan {
  id            Int                   @id @default(autoincrement())
  subjectId     Int                   @unique
  name          String
  description   String?
  monthlyPrice  Decimal               @db.Decimal(10,2)
  yearlyPrice   Decimal?              @db.Decimal(10,2)
  features      Json
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  
  subject       Subject               @relation(fields: [subjectId], references: [id])
  subscriptions SubjectSubscription[]
}

model SubjectSubscription {
  id                   String             @id @default(uuid())
  parentId             String
  subjectPlanId        Int
  studentIds           String[]
  status               SubscriptionStatus @default(TRIAL)
  startDate            DateTime           @default(now())
  endDate              DateTime
  nextBillingDate      DateTime?
  paymentMethod        String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  
  parent               Parent             @relation(fields: [parentId], references: [id])
  subjectPlan          SubjectPlan        @relation(fields: [subjectPlanId], references: [id])
  paymentHistory       PaymentHistory[]
  
  @@unique([parentId, subjectPlanId])
}

model PaymentHistory {
  id                    String              @id @default(uuid())
  subjectSubscriptionId String
  amount                Decimal             @db.Decimal(10,2)
  currency              String              @default("USD")
  status                String
  stripePaymentIntentId String?
  createdAt             DateTime            @default(now())
  
  subscription          SubjectSubscription @relation(fields: [subjectSubscriptionId], references: [id])
}
