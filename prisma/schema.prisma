generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                   String                @id
  username             String                @unique
  name                 String
  email                String?               @unique
  phone                String?               @unique
  img                  String?
  createdAt            DateTime              @default(now())
  parentId             String?
  classId              Int?
  gradeId              Int?
  schoolLevel          Int
  schoolName           String?
  initialSetupComplete Boolean               @default(false)
  level                Int                   @default(1)
  updatedAt            DateTime              @updatedAt
  currentStreak        Int                   @default(0)
  lastActivityDate     DateTime?
  longestStreak        Int                   @default(0)
  xpPoints             Int                   @default(0)
  attendance           Attendance[]
  events               Event[]
  oralPracticeAttempts OralPracticeAttempt[]
  practiceSessions     PracticeSession[]
  results              Result[]
  class                Class?                @relation(fields: [classId], references: [id])
  grade                Grade?                @relation(fields: [gradeId], references: [id])
  parent               Parent?               @relation(fields: [parentId], references: [id])
  studentBadges        StudentBadge[]
  chatSessions         ChatSession[]
  uploadedQuestions    StudentUploadedQuestion[]
  studentQuests        StudentQuest[]
  questionReports      QuestionReport[]
}

model Teacher {
  id                       String            @id
  username                 String            @unique
  name                     String
  email                    String?           @unique
  phone                    String?           @unique
  address                  String?
  img                      String?
  bloodType                String?
  sex                      UserSex?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  classesSupervised        Class[]           @relation("ClassSupervisor")
  lessons                  Lesson[]
  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByTeacher")
  subjectTeachers          SubjectTeacher[]
}

model Parent {
  id                       String            @id
  username                 String            @unique
  name                     String
  phone                    String?           @unique
  email                    String?           @unique
  address                  String?
  referralSource           String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  assignedPracticeSessions PracticeSession[] @relation("AssignedSessionsByParent")
  students                 Student[]
}

model Grade {
  id        Int       @id @default(autoincrement())
  level     Int       @unique
  createdAt DateTime  @default(now())
  name      String?
  updatedAt DateTime  @updatedAt
  classes   Class[]
  students  Student[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String
  capacity      Int?
  gradeId       Int
  supervisorId  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  grade         Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  supervisor    Teacher        @relation("ClassSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  events        Event[]
  lessons       Lesson[]
  students      Student[]

  @@unique([name, gradeId])
}

model Subject {
  id                Int                        @id @default(autoincrement())
  name              String                     @unique
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  archivedQuestions ArchivedOriginalQuestion[] @relation("ArchivedSubjectQuestions")
  lessons           Lesson[]
  oralPrompts       OralPrompt[]
  practiceSessions  PracticeSession[]          @relation("SubjectPracticeSessions")
  questions         Question[]                 @relation("SubjectQuestions")
  subjectTeachers   SubjectTeacher[]
  topics            Topic[]
  uploadedQuestions StudentUploadedQuestion[]  @relation("StudentUploadedQuestionSubjects")
}

model Topic {
  id                Int                        @id @default(autoincrement())
  name              String
  description       String?
  subjectId         Int
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  archivedQuestions ArchivedOriginalQuestion[] @relation("ArchivedTopicQuestions")
  oralPrompts       OralPrompt[]
  practiceSessions  PracticeSession[]
  questions         Question[]                 @relation("TopicQuestions")
  subject           Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedQuestions StudentUploadedQuestion[]  @relation("StudentUploadedQuestionTopics")

  @@unique([name, subjectId])
}

model Lesson {
  id         Int          @id @default(autoincrement())
  name       String
  day        Day?
  startTime  DateTime
  endTime    DateTime
  subjectId  Int
  classId    Int?
  teacherId  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendance Attendance[]
  class      Class?       @relation(fields: [classId], references: [id])
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
}

model QuestionGroup {
  id                   Int                        @id @default(autoincrement())
  createdAt            DateTime                   @default(now())
  description          String?
  name                 String                     @unique
  sourceAssessmentType String?
  sourceLevel          String?
  sourceSchool         String?
  sourceYear           Int?
  updatedAt            DateTime                   @updatedAt
  audioUrl             String?
  archivedQuestions    ArchivedOriginalQuestion[] @relation("ArchivedQuestionGroupQuestions")
  practiceSessions     PracticeSession[]          @relation("BasedOnQuestionGroup")
  questions            Question[]                 @relation("QuestionGroupQuestions")
}

model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  questions QuestionTag[]
}

model Question {
  id                   Int                       @id @default(autoincrement())
  text                 String
  questionType         QuestionType              @default(MULTIPLE_CHOICE)
  options              Json?
  correctAnswer        Json?
  explanation          String?
  difficulty           DifficultyLevel           @default(MEDIUM)
  pointsAwarded        Int                       @default(10)
  subjectId            Int
  topicId              Int
  imageUrl             String?
  audioUrl             String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  hint                 String?
  marks                Int?
  questionGroupId      Int?
  answerKeyRawText     String?
  fullPageImageUrl     String?
  pdfPageNumber        Int
  questionNumberOnPage String
  sourceAssessmentType String?
  sourceLevel          String?
  sourceSchool         String?
  sourceYear           Int?
  productionReady      Boolean                   @default(false)
  isRefactored         Boolean                   @default(false)
  reviewedAt           DateTime?
  archivedVersion      ArchivedOriginalQuestion?
  questionGroup        QuestionGroup?            @relation("QuestionGroupQuestions", fields: [questionGroupId], references: [id])
  subject              Subject                   @relation("SubjectQuestions", fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topic                     @relation("TopicQuestions", fields: [topicId], references: [id], onDelete: Cascade)
  tags                 QuestionTag[]
  studentAnswers       StudentAnswer[]
  reports              QuestionReport[]

  @@unique([questionGroupId, pdfPageNumber, questionNumberOnPage], name: "unique_live_question_in_group_page_num")
}

model ArchivedOriginalQuestion {
  id                   Int             @id @default(autoincrement())
  liveQuestionId       Int             @unique
  pdfPageNumber        Int
  questionNumberOnPage String
  text                 String
  questionType         QuestionType
  options              Json?
  correctAnswer        Json?
  answerKeyRawText     String?
  explanation          String?
  hint                 String?
  marks                Int?
  difficulty           DifficultyLevel
  pointsAwarded        Int
  subjectId            Int
  topicId              Int
  questionGroupId      Int?
  imageUrl             String?
  fullPageImageUrl     String?
  audioUrl             String?
  sourceYear           Int?
  sourceLevel          String?
  sourceSchool         String?
  sourceAssessmentType String?
  archivedAt           DateTime        @default(now())
  liveQuestion         Question        @relation(fields: [liveQuestionId], references: [id], onDelete: Cascade)
  questionGroup        QuestionGroup?  @relation("ArchivedQuestionGroupQuestions", fields: [questionGroupId], references: [id])
  subject              Subject         @relation("ArchivedSubjectQuestions", fields: [subjectId], references: [id], onDelete: SetNull)
  topic                Topic           @relation("ArchivedTopicQuestions", fields: [topicId], references: [id], onDelete: SetNull)
}

model QuestionTag {
  questionId Int
  tagId      Int
  assignedAt DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model PracticeSession {
  id                      String                @id @default(uuid())
  studentId               String
  title                   String?
  status                  PracticeSessionStatus @default(NOT_STARTED)
  subjectId               Int?
  topicId                 Int?
  assignedByParentId      String?
  assignedByTeacherId     String?
  startTime               DateTime              @default(now())
  endTime                 DateTime?
  durationSeconds         Int?
  score                   Int?
  totalQuestions          Int?
  correctAnswers          Int?
  xpEarned                Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  examDurationMinutes     Int?
  type                    PracticeSessionType   @default(PRACTICE)
  basedOnQuestionGroupId  Int?
  challengeWeekIdentifier DateTime?
  assignedByParent        Parent?               @relation("AssignedSessionsByParent", fields: [assignedByParentId], references: [id])
  assignedByTeacher       Teacher?              @relation("AssignedSessionsByTeacher", fields: [assignedByTeacherId], references: [id])
  basedOnQuestionGroup    QuestionGroup?        @relation("BasedOnQuestionGroup", fields: [basedOnQuestionGroupId], references: [id])
  student                 Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject                 Subject?              @relation("SubjectPracticeSessions", fields: [subjectId], references: [id])
  topic                   Topic?                @relation(fields: [topicId], references: [id])
  result                  Result?
  studentAnswers          StudentAnswer[]
}

model StudentAnswer {
  id                String          @id @default(uuid())
  practiceSessionId String
  questionId        Int
  submittedAnswer   Json?
  isCorrect         Boolean?
  pointsEarned      Int             @default(0)
  attemptedAt       DateTime        @default(now())
  feedback          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSessionId, questionId])
}

model Result {
  id                Int             @id @default(autoincrement())
  score             Int
  studentId         String
  practiceSessionId String          @unique
  submittedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  lessonId  Int
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  startTime   DateTime
  endTime     DateTime
  description String
  classId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  studentId   String?
  class       Class?   @relation(fields: [classId], references: [id])
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime @default(now())
  description String
  classId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class?   @relation(fields: [classId], references: [id])
}

model Badge {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String
  icon        String?
  criteria    String
  xpBonus     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  students    StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   Int
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, badgeId])
}

model StudentUploadedQuestion {
  id               String          @id @default(uuid())
  studentId        String
  originalFileName String?         // Keep filename for reference
  text             String
  questionType     QuestionType    @default(MULTIPLE_CHOICE)
  options          Json?
  correctAnswer    Json?
  explanation      String?
  hint             String?
  difficulty       DifficultyLevel @default(MEDIUM)
  subjectId        Int?
  topicId          Int?
  processingStatus ProcessingStatus @default(PROCESSING)
  ocrText          String?         // Raw OCR extracted text for search
  aiProcessingLog  String?         // Log of AI processing steps
  imageUrl         String?         // Only saved when question requires visual elements
  requiresImage    Boolean         @default(false) // AI-detected flag for image dependency
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject          Subject?        @relation("StudentUploadedQuestionSubjects", fields: [subjectId], references: [id], onDelete: SetNull)
  topic            Topic?          @relation("StudentUploadedQuestionTopics", fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([studentId, subjectId])
}

model SubjectTeacher {
  subjectId  Int
  teacherId  String
  assignedAt DateTime @default(now())
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
}

model OralPrompt {
  id                   Int                   @id @default(autoincrement())
  title                String
  subjectId            Int
  topicId              Int?
  promptType           OralPromptType
  description          String?
  studentInstructions  String?
  imageUrl             String?
  videoUrl             String?
  guidingQuestions     Json?
  passageText          String?
  difficulty           DifficultyLevel?      @default(MEDIUM)
  keywords             String[]              @default([])
  estimatedTimeSeconds Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  productionReady      Boolean               @default(false)
  oralPracticeAttempts OralPracticeAttempt[]
  subject              Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                Topic?                @relation(fields: [topicId], references: [id])
}

model OralPracticeAttempt {
  id                String     @id @default(uuid())
  studentId         String
  oralPromptId      Int
  attemptedAt       DateTime   @default(now())
  audioRecordingUrl String?
  transcription     String?
  aiFeedback        Json?
  teacherFeedback   String?
  score             Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  oralPrompt        OralPrompt @relation(fields: [oralPromptId], references: [id], onDelete: Cascade)
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id          String        @id @default(uuid())
  studentId   String
  title       String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lastActivity DateTime     @default(now())
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([studentId, lastActivity])
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  role          MessageRole
  content       String
  imageUrl      String?
  hasImage      Boolean     @default(false)
  timestamp     DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

model Quest {
  id                String             @id @default(uuid())
  questType         String             @unique // 'earn-xp', 'high-accuracy', etc.
  title             String
  description       String
  baseTarget        Int                // Base target value
  targetFormula     String?            // Formula for level-based scaling (e.g., "base + (level * 25)")
  icon              String             // Icon name for frontend
  color             String             // Color theme
  category          WeeklyQuestCategory
  isActive          Boolean            @default(true) // Allow enabling/disabling quests
  minLevel          Int                @default(1)    // Minimum level required for this quest
  maxLevel          Int?               // Maximum level (null = no limit)
  rarity            QuestRarity        @default(COMMON) // How often this quest appears
  xpReward          Int                @default(25)   // XP awarded upon completion
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Relations
  studentQuests     StudentQuest[]
}

model StudentQuest {
  id            String       @id @default(uuid())
  studentId     String
  questId       String
  target        Int          // Calculated target for this student's level
  progress      Int          @default(0)
  isCompleted   Boolean      @default(false)
  completedAt   DateTime?
  weekStart     DateTime     // Monday of the week this quest belongs to
  weekEnd       DateTime     // Sunday of the week this quest belongs to
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quest         Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([studentId, questId, weekStart])
  @@index([studentId, weekStart])
  @@index([weekStart, weekEnd])
  @@index([questId])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum OralPromptType {
  PASSAGE_READING
  PICTURE_CONVERSATION
  VIDEO_CONVERSATION
}

enum UserSex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_THE_BLANK
  OPEN_ENDED
  MULTI_PART
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum PracticeSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PracticeSessionType {
  PRACTICE
  MOCK_EXAM
  ASSIGNMENT_ATTEMPT
  TOPIC_QUIZ
  QUESTION_GROUP_PRACTICE
  WEEKLY_CHALLENGE
  LISTENING_COMPREHENSION
}

enum ProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum WeeklyQuestCategory {
  CORE
  SUBJECT
  CONSISTENCY
  CHALLENGE
  PERFORMANCE
  SOCIAL
  LEARNING
}

enum QuestRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
}

enum QuestionReportType {
  INCORRECT_ANSWER
  WRONG_EXPLANATION
  POOR_FORMATTING
  TECHNICAL_ISSUE
  INAPPROPRIATE_CONTENT
  OTHER
}

model QuestionReport {
  id          String            @id @default(uuid())
  questionId  Int
  studentId   String
  reportType  QuestionReportType
  description String
  status      ReportStatus      @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  question    Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([studentId])
  @@index([status])
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}
