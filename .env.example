# =============================================================================
# Brightly — Environment variables
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit real secrets. `.env` and `.env*.local` are git-ignored.
# =============================================================================

# --- Database (Postgres, used by Prisma) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# Server-side Supabase (never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- AI providers (Bright Ben tutor) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Google Cloud Vision (question image OCR) ---
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# --- Webhooks ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Optional flags ---
# NEXT_PUBLIC_DEBUG_ERRORS=false
